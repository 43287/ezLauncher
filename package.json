{
  "name": "app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "build:portable": "pnpm tauri build --no-bundle && powershell -Command \"taskkill /F /IM ezLauncher.exe /T 2>$null; if (-not (Test-Path output)) { New-Item -ItemType Directory -Force -Path output }; Copy-Item -Force src-tauri/target/release/app.exe output/ezLauncher.exe\"",
    "types:generate": "cd src-tauri && cargo test"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tanstack/react-virtual": "3.14.2",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-autostart": "2.5.1",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@types/dompurify": "3.2.0",
    "clsx": "2.1.1",
    "dompurify": "3.4.11",
    "lucide-react": "1.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.2",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.5.0",
    "postcss": "8.5.15",
    "tailwindcss": "3.4.15",
    "typescript": "5.8.3",
    "vite": "7.3.5",
    "vitest": "4.1.9"
  }
}
